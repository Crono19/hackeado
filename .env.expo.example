HOST=0.0.0.0
PORT=3000
CLIENT_ORIGIN=https://IP-DEL-MAC:3000
SESSION_TTL_MINUTES=30

VITE_SERVER_URL=
VITE_ENABLE_DEBUG_UI=false
ENABLE_DEBUG_UI=false

DEMO_DEVICE_ID=hackeado-windows-vm
