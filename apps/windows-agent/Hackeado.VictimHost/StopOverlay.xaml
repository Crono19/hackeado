<Window x:Class="Hackeado.VictimHost.StopOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control remoto activo" Height="92" Width="690"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        WindowStartupLocation="Manual" Background="#F20A0D0B">
  <Border BorderBrush="#FF3155" BorderThickness="2" Padding="14">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="● CONTROL REMOTO ACTIVO" Foreground="#FF3155" FontFamily="Consolas" FontWeight="Bold" FontSize="17" />
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
          <TextBlock x:Name="OperatorText" Foreground="#F1F5E9" FontFamily="Consolas" FontSize="12" />
          <TextBlock Text="  ·  " Foreground="#718076" />
          <TextBlock x:Name="ElapsedText" Foreground="#BAFF2F" FontFamily="Consolas" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="  ·  CTRL+SHIFT+F12" Foreground="#1BE7D6" FontFamily="Consolas" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" x:Name="StopButton" Content="■ DETENER AHORA" Click="StopButton_Click"
              Background="#FF3155" Foreground="White" BorderThickness="0" Padding="20,11"
              FontFamily="Consolas" FontWeight="Bold" Cursor="Hand" />
    </Grid>
  </Border>
</Window>
