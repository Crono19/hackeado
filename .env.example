HOST=0.0.0.0
PORT=3000
# Orígenes permitidos. En live compilado use https://IP-DEL-MAC:3000.
CLIENT_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
SESSION_TTL_MINUTES=30

# Leave empty to derive the backend URL from the current browser hostname.
VITE_SERVER_URL=

# Native Windows agent. Generate a random key; never commit real value.
DEMO_DEVICE_ID=hackeado-windows-vm
DEMO_AGENT_KEY=replace-with-at-least-32-random-characters
CONTROL_LEASE_SECONDS=15
AGENT_HEARTBEAT_MS=3000
REQUIRE_NATIVE_AGENT=false
ENABLE_DEBUG_UI=false
VITE_ENABLE_DEBUG_UI=false

# Live requiere HTTPS/WSS para captura de pantalla desde otra computadora.
TLS_CERT_PATH=
TLS_KEY_PATH=

